# ==============================================================
# Smart Menu & Cafe System - Environment Configuration
# ==============================================================

# 1. MongoDB Atlas Database (ESSENTIAL for 24/7 permanent cloud data on Vercel)
# Get your free cluster URI from MongoDB Atlas (https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=smart_menu_db

# 2. Server Configuration
PORT=3000
NODE_ENV=production

# 3. Google Gemini AI API Key (Optional, for Smart AI Menu Assistant)
GEMINI_API_KEY=

# 4. Web Push Notification Keys (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
