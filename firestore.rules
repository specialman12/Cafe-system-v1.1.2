rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Orders: readable by clients and admin; creatable by customers; status updateable
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) 
        && incoming().id is string
        && incoming().tableNumber is number
        && incoming().total is number
        && incoming().status in ['pending', 'preparing', 'ready', 'delivered', 'completed', 'cancelled'];
      allow update: if isValidId(orderId)
        && incoming().status in ['pending', 'preparing', 'ready', 'delivered', 'completed', 'cancelled'];
      allow delete: if isValidId(orderId);
    }

    // Tables occupancy and status
    match /tables/{tableNumber} {
      allow read: if true;
      allow write: if true;
    }

    // Bill requests
    match /bill_requests/{billId} {
      allow read: if true;
      allow create: if isValidId(billId) && incoming().tableNumber is number;
      allow update: if isValidId(billId);
      allow delete: if isValidId(billId);
    }

    // Menu Items
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    // System Settings & Branding
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
